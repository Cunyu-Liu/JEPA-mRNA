# Code lives in /home, large artefacts live in /mnt/cunyuliu. Never commit data,
# weights, checkpoints or evaluation output.
# Data artefacts (raw corpora, extracted JSONL, downloaded archives) are never
# committed -- they live under /mnt/cunyuliu.  The code that *builds* them is
# source and does belong here, so source-like files are re-included below.
data/**
!data/**/
!data/**/*.py
!data/**/*.md
!data/**/*.json
runs/
eval_out/
weights/

# Upstream checkouts and copies of the released HF repo: reproducible by cloning /
# downloading, and large. The repo stores paths and md5s, not the bytes.
third_party/
weights_ref/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local scratch
*.bak
*.tmp